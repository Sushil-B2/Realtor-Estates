# GEMINI_API_KEY: Required if Gemini AI calls are added server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CRM_WEBHOOK_URL: Optional HTTPS CRM endpoint for automated lead & email sequence dispatch.
CRM_WEBHOOK_URL=""

# CRM_API_KEY: Optional Bearer token for outbound CRM webhook authentication (kept server-side).
CRM_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform client API key (restrict by HTTP referrer & APIs).
VITE_GOOGLE_MAPS_API_KEY=""


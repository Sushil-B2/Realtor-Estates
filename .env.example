# Realtor Estates — environment template.
#
# Copy to `.env`, fill in, then:  chmod 600 .env
#   cp .env.example .env
#
# `.env` is git-ignored. This file is not, so it must never contain a real
# secret. Every value below is a placeholder and is rejected by the boot
# validator if used in production.
#
# Generate the master key:  python3 -c "import secrets;print(secrets.token_hex(32))"
# Verify your setup:        python3 scripts/check_secrets.py
# Full policy:              docs/11-SECRETS-MANAGEMENT.md

# --- runtime ---------------------------------------------------------------
RE_ENV=development            # development | production | staging
# RE_PORT=8000
# RE_DATA_DIR=./data
# RE_KEY_FILE=./data/keys.json   # dev fallback only; ignored when RE_MASTER_KEY is set
# RE_ENV_FILE=/run/secrets/realtor.env   # e.g. a systemd LoadCredential path

# --- the one secret that matters -------------------------------------------
# 32 bytes minimum. Hex (64 chars) preferred. Everything else is derived from
# this with HKDF-SHA256: field_enc, blind_index, session, audit, webhook.
RE_MASTER_KEY=replace-with-64-hex-chars-from-secrets-token-hex-32
# Optional: pin the outbound webhook signing key instead of deriving it.
RE_WEBHOOK_SIGNING_SECRET=

# --- KMS envelope (docs/30) --------------------------------------------------
# With an envelope, the root above is no longer read from here: it is unwrapped
# at boot from .secrets/dek.envelope by a key-encryption key, and a wrong KEK is
# a boot failure, not a fallback. Create one with:
#   python3 scripts/kms_envelope.py init --provider env
# Nothing is enabled by default — an installation with no envelope behaves
# exactly as before. Delete RE_MASTER_KEY only after an init + a restart + a
# confirmed contact read.
# RE_ENVELOPE_FILE=.secrets/dek.envelope
# RE_KMS_KEK=                     # 32 bytes hex or base64, from LoadCredential/Docker secret/Vault
# RE_KMS_KEK_PREVIOUS=            # only while rotating: the old KEK, until a rewrap has booted
# RE_KMS_URL=                     # or point at a KMS: POST /wrap and POST /unwrap
# RE_KMS_TOKEN=
# RE_KMS_KEK_FILE=./data/kms-kek.json   # development only; refused when RE_ENV=production

# --- shared security state (docs/31) -----------------------------------------
# Rate limits and token revocations are per process by default. That is correct
# on one instance and not a control on two: ten instances multiply every bucket
# by ten, and a logout only bites on the node that served it. Set ONE of these
# before adding a second instance. Production refuses to boot if the backend you
# name does not answer.
# RE_REDIS_URL=redis://127.0.0.1:6379/0     # or unix:///run/redis/redis.sock
# RE_SHARED_DIR=/var/lib/realtor/shared      # one host only (two gunicorn workers)
# RE_SHARED_STATE=redis                      # optional: memory | redis | file
# RE_REDIS_TIMEOUT=1.5

# --- LLM providers (optional — agents fall back to the deterministic router)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
JEV_API_KEY=                   # thejev.com / jev-ultrafast

# --- voice (optional — simulator is used when absent) ----------------------
SARVAM_API_KEY=                # ~$0.01/min, mr/hi/en
ELEVENLABS_API_KEY=            # premium upsell

# --- messaging (optional) ---------------------------------------------------
WHATSAPP_TOKEN=                # WhatsApp Cloud API
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=         # inbound webhook verification
SMS_API_KEY=
SMS_SENDER_ID=                 # DLT header, e.g. SNRSUN

# --- paid ads (optional) ----------------------------------------------------
META_ADS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- billing (optional) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- observability (optional) ----------------------------------------------
SENTRY_DSN=

# --- Neon services (filled by `neon deploy` → .env.local) ---
# Neon Postgres DSN (activates the SQL backend; blank = JSON store)
DATABASE_URL=
# Neon AI Gateway base URL (OpenAI-compatible)
NEON_AI_GATEWAY_URL=
# Neon AI Gateway API key
NEON_AI_GATEWAY_KEY=
# Default model routed through the gateway
NEON_AI_GATEWAY_MODEL=
# Neon Auth base URL for token introspection
NEON_AUTH_BASE_URL=
# S3-compatible object storage endpoint
NEON_STORAGE_ENDPOINT=
# Bucket for exported PDFs, listing media, call recordings
NEON_STORAGE_BUCKET=projectassets
# Storage access key id
NEON_STORAGE_ACCESS_KEY=
# Storage secret access key
NEON_STORAGE_SECRET_KEY=
# Storage region (use 'auto' when unsure)
NEON_STORAGE_REGION=
# Neon Realtime websocket endpoint
NEON_REALTIME_URL=
# Neon Realtime authorisation token
NEON_REALTIME_TOKEN=
# Base URL of deployed Neon Functions
NEON_FUNCTIONS_URL=
# ---- sessions (docs/28) ----
# Access-token lifetime in seconds. Short is the point: a stolen access token is a
# nuisance for this long, and no longer. 1800 = 30 minutes.
RE_ACCESS_TTL=
# Refresh-token lifetime in seconds, i.e. how long a device stays signed in.
# 2592000 = 30 days. A shared site-office machine wants this much smaller.
RE_REFRESH_TTL=

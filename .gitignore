# ---------------------------------------------------------------------------
# SECRETS — the single most important block in this file.
# Anything matched here must never be committed. scripts/check_secrets.py
# verifies this and fails CI if a secret ever becomes tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*
data/keys.json
data/store.json
# KMS envelope (docs/30): the development KEK and any envelope that lands under
# data/ instead of .secrets/ (RE_KMS_KEK_FILE / RE_ENVELOPE_FILE overrides).
data/kms-kek.json
data/dek.envelope
.pgdata*
.env.local
# Anything dropped into the workspace by a person or an upload widget is
# untrusted by definition: it is where a credential pasted "for a moment" ends
# up. Never committable, and scripts/check_secrets.py scans it explicitly.
uploads/
# The CLI credential (Neon API key) lives here, not in the runtime env: see
# docs/17-SECRET-HANDLING.md. (`.neon` is a *file* — the CLI link context — so the
# credential gets its own directory.)
.secrets/

# ---------------------------------------------------------------------------
# runtime / build
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
node_modules/
dist/
build/
coverage/
.DS_Store

# logs (may contain customer data or tokens)
*.log
logs/

# reports are regenerated by the harness; the latest pair is committed on purpose
!reports/redline-report.md
!reports/redline-report.json
.neon

# redline / sentinel session caches (credentials)
redline/.redline-token.json
sentinel/.sentinel-token.json

[build]
  publish = "web"

[[redirects]]
  from = "/api/*"
  to = "https://api-crm.yourdomain.com/api/:splat"
  status = 200
  force = true

[[redirects]]
  from = "/f/*"
  to = "https://api-crm.yourdomain.com/f/:splat"
  status = 200
  force = true

[[redirects]]
  from = "/healthz"
  to = "https://api-crm.yourdomain.com/healthz"
  status = 200
  force = true

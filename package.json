{
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@electric-sql/pglite": "0.5.16",
    "@neon/config": "1.14.2",
    "@neon/env": "2.1.5",
    "@neon/functions": "0.11.0",
    "pg": "8.23.1",
    "pglite-server": "0.1.5",
    "sharp": "0.35.5"
  },
  "name": "realtor-estates",
  "version": "1.39.0",
  "private": true,
  "description": "Realtor Estates \u2014 real-estate revenue OS. Python PWA; this package.json holds the Neon deploy policy, local Postgres stand-in and the verification entrypoints.",
  "type": "module",
  "scripts": {
    "build": "npm run verify",
    "verify": "python3 -m compileall -q app scripts tests && node scripts/check-js.mjs && python3 scripts/check_a11y.py && python3 -m pytest tests -q && python3 scripts/check_secrets.py && python3 scripts/doc_facts.py --check",
    "verify:pg": "python3 scripts/verify_postgres.py",
    "start": "python3 -m app.server --port 8000",
    "test": "python3 -m pytest tests -q",
    "db:status": "python3 -m app.db status",
    "db:migrate": "python3 -m app.db migrate",
    "db:ping": "python3 -m app.db ping",
    "pg:local": "node scripts/pg-local.mjs 5433",
    "neon:plan": "neon config plan",
    "neon:deploy": "neon deploy",
    "secrets:check": "python3 scripts/check_secrets.py --history",
    "db:connect": "python3 scripts/connect-db.py --from-env",
    "db:connect:check": "python3 scripts/connect-db.py --from-env --no-write",
    "audit:sentinel": "python3 sentinel/agent.py",
    "audit:sentinel:deep": "python3 sentinel/agent.py --deep",
    "audit:sentinel:strict": "python3 sentinel/agent.py --deep --strict",
    "audit:sentinel:gate": "python3 sentinel/agent.py --self-test",
    "db:provision-role": "python3 scripts/provision_app_role.py",
    "db:prune-probes": "python3 scripts/prune_probe_accounts.py --apply",
    "photos:proof": "node scripts/proof-photo-pipeline.mjs",
    "functions:dev": "tsx functions/dev-serve.mjs",
    "sweep:proof": "node scripts/proof-compliance-sweep.mjs",
    "webhook:proof": "node scripts/proof-payments-webhook.mjs",
    "functions:deploy": "scripts/deploy_functions.sh",
    "functions:proof": "python3 scripts/proof_deployed_functions.py",
    "docs:check": "python3 scripts/doc_facts.py --check",
    "automations:proof": "python3 scripts/proof_automations.py",
    "money:proof": "python3 scripts/proof_money.py",
    "images:proof": "python3 scripts/proof_property_images.py",
    "demo:hygiene": "python3 scripts/reset_demo.py",
    "verify:pg:local": "python3 scripts/verify_postgres.py --local",
    "verify:pg:real": "python3 scripts/verify_postgres.py --real",
    "storage:proof": "python3 scripts/proof_storage_uploads.py",
    "realtime:proof": "python3 scripts/proof_realtime_inboxes.py",
    "govt:proof": "python3 scripts/proof_govt_sales_cycle.py",
    "hardening:proof": "python3 scripts/proof_security_hardening_v136.py",
    "mcp:proof": "python3 scripts/proof_mcp_openapi_oauth_sdks.py",
    "agency:proof": "python3 scripts/proof_agency_dag_calendar_reputation.py",
    "a11y:check": "python3 scripts/check_a11y.py",
    "enterprise:proof": "python3 scripts/proof_observability_sso_a11y.py"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
